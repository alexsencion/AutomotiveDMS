{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug"
    }
  },

  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext:l}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\mssqllocaldb;Initial Catalog=AutomotiveDMS_Dev;Integrated Security=true;TrustServerCertificate=True"
  },

  "JwtSettings": {
    "Secret": "dev-secret-key-256-bits-long-minimum-for-hs256-algorithm-development-only"
  },

  "SendGrid": {
    "ApiKey": "dev-key-placeholder"
  },

  "Twilio": {
    "AccountSid": "dev-account-sid-placeholder",
    "AuthToken": "dev-auth-token-placeholder",
    "FromNumber": "+1234567890"
  },

  "Azure": {
    "BlobStorage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "documents-dev"
    }
  },

  "App": {
    "Domain": "http://localhost:8080"
  },

  "Seed": {
    "AdminEmail": "admin@automotivedms.com",
    "AdminPassword": "Admin@12345!",
    "AdminFirstName": "System",
    "AdminLastName": "Administrator"
  }
}