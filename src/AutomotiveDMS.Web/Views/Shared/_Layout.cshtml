<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Automotive DMS</title>

    <!-- Bootstrap 5.3 CDN (replaced with local copy in Step 10 wwwroot setup) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
        
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">
                Automotive DMS
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle"collapse" data="-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Vehicles" asp-action="Index">
                            Vehicles
                        </a>
                    </li>
                    <li class="nav-item">
                            <a class="nav-link" asp-controller="Customers" asp-action="Index">
                            Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customers" asp-action="Index">
                            Financing
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#"
                            data-bs-toggle="dropdown">
                            @User.Identity.Name        
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item"
                                        asp-controller="Users" asp-action="Index">
                                        Manage Users
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form asp-controller="Account" asp-action="Logout"
                                      method="post" id="logoutForm">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
}

<main class="container-fluid mt-3">
    @* Global alert partial — for TempData success/error messages *@
    @await Html.PartialAsync("_AlertPartial")

    @RenderBody()
</main>

<!-- Bootstrap 5.3 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
