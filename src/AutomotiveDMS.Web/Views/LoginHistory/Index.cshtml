@model LoginHistoryIndexViewModel 
@{
    ViewData["Title"] = "Login History";
}

<h2 class="fw-bold mb-3">Login History</h2>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label asp-for="UserId" class="form-label small fw-semibold">User</label>
            <select asp-for="UserId" asp-items="Model.Users" class="form-select form-select-sm">
                <option value="">Everyone</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="Email" class="form-label small fw-semibold">Email contains</label>
            <input asp-for="Email" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label asp-for="EventTypeFilter" class="form-label small fw-semibold">Event</label>
            <select asp-for="EventTypeFilter" asp-items="Model.EventTypes" class="form-select form-select-sm">
                <option value="">Any</option>
            </select>    
        </div>
        <div class="col-md-1">
            <label asp-for="From" class="form-label small fw-semibold">From</label>
            <input asp-for="From" type="date" class="form-control form-control-sm" />
        </div>
        <div class="col-md-1">
            <label asp-for="To" class="form-label small fw-semibold">To</label>
            <input asp-for="To" type="date" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-fill">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
        </div>
    </div>
    <div asp-validation-summary="All" class="text-danger small mt-2"></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>When (DR time)</th>
                    <th>User</th>
                    <th>Email used</th>
                    <th>Event</th>
                    <th>IP</th>
                    <th>Device</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Result.TotalCount == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No login events match these filters.</td></tr>
            }
            @foreach (var e in Model.Result.Items)
            {
                <tr>
                    <td class="text-nowrap">@DominicanTime.FromUtc(e.OccurredAtUtc).ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                    <td>@(e.UserName ?? "-")</td>
                    <td>@e.Email</td>
                    <td><span class="badge @LoginEventDisplay.Badge(e.EventType)">@LoginEventDisplay.Label(e.EventType)</span></td>
                    <td class="small text-muted">@e.IpAddress</td>
                    <td class="small text-muted">
                        <span class="text-truncate d-inline-block align-bottom" style="max-width: 260px"
                               title="@e.UserAgent">@e.UserAgent</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Result.TotalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-muted">
            Page @Model.Result.Page of @Model.Result.TotalPages · @Model.Result.TotalCount events
        </span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Result.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" 
                    asp-all-route-data="Model.RouteValuesForPage(Model.Result.Page - 1)">Previous</a>
            </li>
            <li class="page-item @(Model.Result.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                    asp-all-route-data="Model.RouteValuesForPage(Model.Result.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}