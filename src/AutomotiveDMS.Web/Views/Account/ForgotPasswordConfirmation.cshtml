@{
    ViewData["Title"] = "Check Your Email";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Check your email</h4>
                <p class="text-muted">
                    If an active account exists for that address, a password reset
                    link has been sent. The link expires in 1 hour.
                </p>
                <a asp-action="Login" class="btn btn-outline-secondary mt-2">
                    Back to sign in
                </a>
            </div>
        </div>
    </div>
</div>