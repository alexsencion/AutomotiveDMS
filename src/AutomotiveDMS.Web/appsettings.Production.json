{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/automotivedms/app-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/ConnectionString/)"
  },

  "Seed": {
    "AdminEmail": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/SeedAdminEmail/)",
    "AdminPassword": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/SeedAdminPassword/)",
    "AdminFirstName": "System",
    "AdminLastName": "Administrator"
  },


  "JwtSettings": {
    "Secret": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/ConnectionString/)"
  },

  "SendGrid": {
    "ApiKey": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/SendGridApiKey/)",
    "SenderEmail": "noreply@automotivedms.com"
  },

  "Twilio": {
    "AccountSid": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/TwilioAccountSid/)",
    "AuthToken": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/TwilioAuthToken/)"
  },

  "Azure": {
    "BlobStorage": {
      "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://automotivedms-kv.vault.azure.net/secrets/BlobStorageConnectionString/)"
    }
  }
}