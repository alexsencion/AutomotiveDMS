{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.txt",
          "rollingInternal": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "JwtSettings": {
    "Secret": "",
    "Issuer": "AutomotiveDMS",
    "Audience": "AutomotiveDMS",
    "ExpiryMinutes": 60
  },

  "SendGrid": {
    "ApiKey": "",
    "SenderEmail": "noreply@automotivedms.com",
    "SenderName": "Automotive DMS"
  },

  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": "+1234567890"
  },

  "Azure": {
    "BlobStorage": {
      "ConnectionString": "",
      "ContainerName": "documents"
    },
    "KeyVault": {
      "VaultUri": "",
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "App": {
    "Pagination": {
      "DefaultPageSize": 10,
      "MaxPageSize": 100
    },
    "FileUpload": {
      "MaxFileSizeBytes": 52428800,
      "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".jpg", ".jpeg", ".png" ]
    },
    "Domain": "https://automotivedms.example.com"
  }
}
